# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# MySQL/MariaDB connection used by Prisma. On a Pi set up with docs/raspberryPiSetup.md, the password is password1.
DATABASE_URL="mysql://rc_timer_user:CHANGE_ME@localhost:3306/rc_lap_timer"

# Enables the System Settings screen (device name, Pi password). Leave unset to keep it disabled.
# On the Pi, set this in /etc/rc-lap-timer.env instead so upgrades don't overwrite it.
# ADMIN_PIN=

# Which app to build: pi (the default) or standalone, the phone-only app with the Pi's features hidden.
# NEXT_PUBLIC_TARGET=pi

# Sites whose phone app may sync with this timer (comma-separated). The default is https://kbennett2000.github.io.
# SYNC_ALLOWED_ORIGINS=

# The Remote LED display's address on the timer's Wi-Fi. The default is 192.168.4.99.
# LED_DEVICE_IP=
